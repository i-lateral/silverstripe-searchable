    "type": "silverstripe-vendormodule",
    "homepage": "http://github.com/dft/silverstripe-searchable",
    "keywords": [
        "silverstripe",
        "search",
        "searchform",
        "dataobject"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "DFT",
            "homepage": "http://github.com/Dean-Forest-Tech/silverstripe-searchable"
        }
    ],
    "support": {
        "issues": "http://github.com/dft/silverstripe-searchable/issues"
